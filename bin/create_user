#!/usr/bin/env bash

set -euo pipefail

passwordfile=/var/www/data/htdigest
realm=SabreDAV
username=$1

if [ -z "$username" ]; then
    echo "Usage: $0 <username>"
    exit 1
fi

if [ ! -f "$passwordfile" ]; then
    echo "Info: creating new passwordfile $passwordfile"
    touch $passwordfile
    chown -R www-data:www-data $passwordfile
    chmod 640 $passwordfile # Owner can read and write, group can read, others have no permissions.
fi

htdigest "$passwordfile" "$realm" "$username"
echo "Success: added user $username:$realm to $passwordfile"

